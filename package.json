{
  "name": "line-launcher",
  "private": true,
  "description": "Line Launcher by Plus In Plus — provider-configured Minecraft launcher",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "npm run brand && vite --host 0.0.0.0",
    "check": "tsc -b --pretty false",
    "build": "npm run brand && npm run check && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "prepare": "lefthook install",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:java": "node scripts/test-java-client.mjs",
    "brand": "node --experimental-strip-types scripts/apply-brand.ts",
    "brand:check": "node --experimental-strip-types scripts/apply-brand.ts --check",
    "tauri:build": "npm run brand && node scripts/tauri-build.mjs",
    "test:rust": "node scripts/test-rust-pure.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:boot": "node scripts/ui-boot-smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:provider": "node scripts/test-provider.mjs",
    "test:wardrobe": "node scripts/test-wardrobe-provider.mjs",
    "pack:manifest": "node scripts/pack-manifest.mjs",
    "provider:pack": "node examples/provider/build-pack.mjs",
    "provider:serve": "node examples/provider/server.mjs",
    "design": "node scripts/serve-design.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:app": "node scripts/demo.mjs --app-only",
    "demo:doctor": "node scripts/demo-doctor.mjs",
    "demo:update": "node examples/provider/publish-release.mjs",
    "demo:check": "node scripts/demo-selftest.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:tauri": "node scripts/check-tauri-versions.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "~2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.12",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.6"
  }
}
